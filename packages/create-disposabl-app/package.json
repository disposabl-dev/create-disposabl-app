{
  "name": "create-disposabl-app",
  "version": "0.0.0-development",
  "description": "Create a Disposabl app",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/disposabl-dev/create-disposabl-app.git",
    "directory": "packages/create-disposabl-app"
  },
  "bin": {
    "create-disposabl-app": "dist/index.js",
    "disposabl": "dist/disposabl.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun build.ts",
    "typecheck": "bun check",
    "lint": "cd ../.. && eslint --config packages/create-disposabl-app/eslint.config.ts packages/create-disposabl-app reset.ts",
    "format": "bun fmt",
    "verify:starter": "bun ../tests/starter-ci.ts",
    "prepack": "node dist/verify-metadata.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/core": "1.5.1",
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "picocolors": "1.1.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@semantic-release/exec": "7.1.0",
    "@types/bun": "1.4.4",
    "eslint": "10.14.0",
    "jiti": "2.7.0",
    "semantic-release": "25.0.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "conventional-changelog-conventionalcommits": "9.3.1"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "breaking": true,
              "release": "major"
            },
            {
              "type": "feat",
              "release": "minor"
            },
            {
              "release": "patch"
            }
          ],
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/npm",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "bun run build"
        }
      ],
      [
        "@semantic-release/github",
        {
          "successComment": false,
          "failComment": false,
          "releasedLabels": false
        }
      ]
    ]
  }
}
