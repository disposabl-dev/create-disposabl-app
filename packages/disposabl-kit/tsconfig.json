{
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [".", "../../apps/web/src/routeTree.gen.ts"],
  "exclude": ["node_modules", "dist", "mobile"]
}
