import { atmn, feature, plan } from "atmn";
import { pricing, creditQuantity } from "./config";

export const credits = feature({
  featureId: pricing.featureId,
  name: "Credits",
  type: "metered",
  consumable: true,
});
export const monthly = plan({
  planId: pricing.monthly.planId,
  versionSlug: "v1",
  active: true,
  name: "Monthly credits",
  price: { amount: pricing.monthly.price, interval: "month" },
  items: [{
    featureId: credits.featureId,
    included: creditQuantity("monthly"),
    reset: { interval: "month" },
  }],
});
export const topup = plan({
  planId: pricing.topup.planId,
  versionSlug: "v1",
  active: true,
  name: "Credits top-up",
  addOn: true,
  items: [{
    featureId: credits.featureId,
    price: {
      amount: pricing.topup.price,
      billingUnits: creditQuantity("topup"),
      interval: "one_off",
      billingMethod: "prepaid",
    },
  }],
});
export default atmn({ features: [credits], plans: [monthly, topup] });
