+import { v } from "convex/values";
+import { mutation } from "./_generated/server.js";
+const BATCH = 100;
+export async function isErased(ctx, userId) {
+    return (await ctx.db.query("erasedUsers").withIndex("userId", q => q.eq("userId", userId)).unique()) !== null;
+}
+// Component API: call repeatedly until done. The immutable fence remains.
+export const eraseUserBatch = mutation({
+    args: { userId: v.string() },
+    returns: v.object({ doneAttributed: v.boolean(), requestsDeleted: v.number(), tokensDeleted: v.number(), grantsDeleted: v.number() }),
+    handler: async (ctx, { userId }) => {
+        if (!userId)
+            throw new Error("userId required");
+        if (!await isErased(ctx, userId))
+            await ctx.db.insert("erasedUsers", { userId });
+        const requests = await ctx.db.query("authRequests").withIndex("userId", q => q.eq("userId", userId)).take(BATCH);
+        for (const request of requests)
+            await ctx.db.delete("authRequests", request._id);
+        const grant = await ctx.db.query("grants").withIndex("userId", q => q.eq("userId", userId)).first();
+        let tokensDeleted = 0, grantsDeleted = 0;
+        if (grant) {
+            const tokens = await ctx.db.query("tokens").withIndex("grantId", q => q.eq("grantId", grant._id)).take(BATCH);
+            for (const token of tokens)
+                await ctx.db.delete("tokens", token._id);
+            tokensDeleted = tokens.length;
+            if (tokens.length < BATCH) {
+                await ctx.db.delete("grants", grant._id);
+                grantsDeleted = 1;
+            }
+        }
+        const remainingRequest = await ctx.db.query("authRequests").withIndex("userId", q => q.eq("userId", userId)).first();
+        const remainingGrant = await ctx.db.query("grants").withIndex("userId", q => q.eq("userId", userId)).first();
+        return { doneAttributed: !remainingRequest && !remainingGrant, requestsDeleted: requests.length, tokensDeleted, grantsDeleted };
+    },
+});
+//# sourceMappingURL=erasure.js.map
