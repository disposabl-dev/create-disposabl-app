{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["BUN_VERSION", "NODE_VERSION"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".output/app/**"],
      "env": ["VITE_CONVEX_SITE_URL", "VITE_CONVEX_URL"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "@disposabl/tests#typecheck": {
      "dependsOn": ["^typecheck", "@disposabl/sdk#typecheck"]
    },
    "@disposabl/sdk#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/backend/generated/openapi.json"
      ],
      "cache": false
    },
    "@disposabl/web#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!src/routeTree.gen.ts"],
      "outputs": ["src/routeTree.gen.ts"]
    },
    "@disposabl/disposabl-kit#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/backend/convex/**"]
    },
    "@disposabl/disposabl-kit#lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/backend/convex/**"]
    },
    "@disposabl/disposabl-kit#typecheck": {
      "dependsOn": ["^typecheck", "@disposabl/web#generate:routes"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/backend/convex/**"]
    },
    "create-disposabl-app#build": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["VITE_*"]
    },
    "@disposabl/backend#dev": {
      "cache": false,
      "persistent": true,
      "with": ["@disposabl/backend#generate:watch"]
    },
    "generate:watch": {
      "cache": false,
      "persistent": true
    },
    "@disposabl/docs#build": {
      "cache": false
    },
    "@disposabl/web#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@disposabl/web#generate:routes": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/routeTree.gen.ts",
        "$TURBO_ROOT$/packages/disposabl-kit/client/vite.config.ts"
      ],
      "outputs": ["src/routeTree.gen.ts"]
    }
  },
  "globalDependencies": ["disposabl.json"]
}
