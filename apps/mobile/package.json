    "dev": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "build:ios": "bunx eas-cli@27.2.0 build --platform ios --profile ios-preview --local"
  },
  "private": true,
  "expo": {
    "autolinking": {
