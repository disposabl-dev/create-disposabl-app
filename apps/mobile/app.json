{
  "expo": {
    "name": "Disposabl",
    "slug": "disposabl",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.disposabl.mobile",
      "version": "1.1.0",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "com.posthog.posthog.CAPTURE_PUSH_NOTIFICATION_OPENED": false
      }
    },
    "android": {
      "package": "com.yastai.disposabl",
      "version": "1.1.0",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@disposabl/disposabl-kit/mobile/expo-plugin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to attach to your app request.",
          "cameraPermission": "Take a photo to attach to your app request.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
