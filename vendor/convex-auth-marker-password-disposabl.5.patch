+
+/** App-server-only bounded erasure; tombstone prevents old-user recreation. */
+export const eraseUserPasswords = mutation({
+  args: { userId: v.string() },
+  returns: v.object({ complete: v.boolean(), deleted: v.number() }),
+  handler: async (ctx, { userId }) => {
+    if (!userId) throw new Error("Missing user ID.");
+    if (!(await erasedUser(ctx, userId)))
+      await ctx.db.insert("erasedUsers", { userId, erasedAt: Date.now() });
+    const rows = await ctx.db.query("passwords").withIndex("by_userId", q => q.eq("userId", userId)).take(101);
+    for (const row of rows.slice(0, 100)) await ctx.db.delete("passwords", row._id);
+    return { complete: rows.length <= 100, deleted: Math.min(rows.length, 100) };
+  },
+});
+async function erasedUser(ctx: QueryCtx, userId: string) {
+  return await ctx.db.query("erasedUsers").withIndex("by_userId", q => q.eq("userId", userId)).unique();
+}
