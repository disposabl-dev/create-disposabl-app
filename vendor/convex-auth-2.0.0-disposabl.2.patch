+/** Component-only import primitives. They do not open auth or establish that a
+ * source snapshot is complete; the app's atomic coordinator must do both. */
+import { v } from "convex/values";
+import { mutation } from "./_generated/server.ts";
+
+const itemLimit = <T>(items: T[]) => {
+  if (items.length > 100) throw new Error("Migration batch exceeds 100 rows");
+};
+export const importCutoffs = mutation({
+  args: { rows: v.array(v.object({ digest: v.string(), cutoff: v.number() })) },
+  returns: v.null(),
+  handler: async (ctx, { rows }) => {
+    itemLimit(rows);
+    for (const row of rows) {
+      if (!/^[a-f0-9]{64}$/.test(row.digest) || !Number.isFinite(row.cutoff))
+        throw new Error("Invalid cutoff");
+      const existing = await ctx.db
+        .query("identityErasure")
+        .withIndex("by_digest", (q) => q.eq("digest", row.digest))
+        .unique();
+      if (existing && existing.cutoff !== row.cutoff)
+        throw new Error("Cutoff conflict");
+      if (!existing) await ctx.db.insert("identityErasure", row);
+    }
+    return null;
+  },
+});
+export const importErasedUsers = mutation({
+  args: {
+    rows: v.array(v.object({ userId: v.string(), requestedAt: v.number() })),
+  },
+  returns: v.null(),
+  handler: async (ctx, { rows }) => {
