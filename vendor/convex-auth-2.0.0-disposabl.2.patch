+import { convexTest } from "convex-test";
+import { expect, test } from "vitest";
+import { api } from "./_generated/api.ts";
+import schema from "./schema.ts";
+
+const modules = import.meta.glob("./**/*.ts");
+test("a mapped identity is fenced before purge and remains fenced after its mapping is removed", async () => {
+  const t = convexTest({ schema, modules });
+  await t.mutation(api.provider._internal_dangerous_createAccount, {
+    providerAccountId: "identity-a",
+    userId: "user-a",
+  });
+  await t.mutation(api.provider._internal_dangerous_createAccount, {
+    providerAccountId: "identity-b",
+    userId: "user-b",
+  });
+  const staleUserId = await t.query(api.provider.getUserIdByAccount, {
+    providerAccountId: "identity-a",
+  });
+  expect(staleUserId).toBe("user-a");
+  await t.mutation(api.provider.beginUserErasure, { userId: "user-a" });
+  await expect(
+    t.mutation(api.provider._internal_dangerous_createAccount, {
+      providerAccountId: "identity-a",
+      userId: staleUserId!,
+    }),
+  ).rejects.toThrow();
+  await expect(
+    t.query(api.provider.getUserIdByAccount, {
+      providerAccountId: "identity-a",
+    }),
+  ).rejects.toThrow();
+  expect(
+    await t.mutation(api.provider.purgeUserLinkedAuth, { userId: "user-a" }),
+  ).toEqual({ complete: true, deletedAccounts: 1 });
+  await expect(
+    t.query(api.provider.getUserIdByAccount, {
+      providerAccountId: "identity-a",
+    }),
+  ).rejects.toThrow();
+  await expect(
+    t.mutation(api.provider._internal_dangerous_createAccount, {
+      providerAccountId: "identity-a",
+      userId: "fresh-user",
+    }),
+  ).rejects.toThrow();
+  expect(
+    await t.query(api.provider.getUserIdByAccount, {
+      providerAccountId: "identity-b",
+    }),
+  ).toBe("user-b");
+});
+
+test("concurrent account creation and fence prevent reuse of the erased user ID", async () => {
+  const t = convexTest({ schema, modules });
+  await Promise.allSettled([
+    t.mutation(api.provider._internal_dangerous_createAccount, {
+      providerAccountId: "raced",
+      userId: "owner",
+    }),
+    t.mutation(api.provider.beginUserErasure, { userId: "owner" }),
