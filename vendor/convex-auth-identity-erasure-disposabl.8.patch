@@ -119,0 +122,14 @@ export const deleteUsername = mutation({
+/** Permanently fence the old user ID and remove its username. App-server only. */
+export const eraseUser = mutation({
+  args: { userId: v.string() },
+  returns: v.object({ deleted: v.boolean() }),
+  handler: async (ctx, { userId }) => {
+    const tombstone = await ctx.db.query("erasedUsers").withIndex("by_userId", q => q.eq("userId", userId)).unique();
+    if (!tombstone) await ctx.db.insert("erasedUsers", { userId, erasedAt: Date.now() });
+    const row = await rowByUserId(ctx, userId);
+    if (!row) return { deleted: false };
+    await ctx.db.delete("usernames", row._id);
+    return { deleted: true };
+  },
+});
+
