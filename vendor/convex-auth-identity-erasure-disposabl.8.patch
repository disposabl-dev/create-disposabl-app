diff --git a/src/components/email/verifiedEmails.ts b/src/components/email/verifiedEmails.ts
index 2de2e09..17ea000 100644
--- a/src/components/email/verifiedEmails.ts
+++ b/src/components/email/verifiedEmails.ts
@@ -116,0 +117,15 @@ export const deleteUser = mutation({
+
+/** App-server only. Establish a permanent fence and delete bounded attributed rows. */
+export const eraseUserBatch = mutation({
+  args: { userId: v.string() },
+  returns: v.object({ emailsDeleted: v.number(), challengesDeleted: v.number(), complete: v.boolean() }),
+  handler: async (ctx, { userId }) => {
+    const tombstone = await ctx.db.query("erasedUsers").withIndex("by_userId", q => q.eq("userId", userId)).unique();
+    if (!tombstone) await ctx.db.insert("erasedUsers", { userId, erasedAt: Date.now() });
+    const emails = await ctx.db.query("verifiedEmails").withIndex("by_userId", q => q.eq("userId", userId)).take(100);
+    const challenges = await ctx.db.query("challenges").withIndex("by_purpose_userId", q => q.eq("purpose.userId", userId)).take(100);
+    for (const row of emails) await ctx.db.delete("verifiedEmails", row._id);
+    for (const row of challenges) await ctx.db.delete("challenges", row._id);
+    return { emailsDeleted: emails.length, challengesDeleted: challenges.length, complete: emails.length < 100 && challenges.length < 100 };
+  },
+});
