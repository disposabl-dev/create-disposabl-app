   },
 });
+/** Bounded cleanup of linked records only; older orphan refresh tokens lack a user join. */
+export const purgeUserLinkedAuth = mutation({
+  args: { userId: v.string() },
+  returns: v.object({ linkedRowsCleared: v.boolean(), deletedAccounts: v.number(), deletedSessions: v.number(), deletedRefreshTokens: v.number(), legacyOrphansUnverified: v.literal(true) }),
+  handler: async (ctx, { userId }) => {
+    if (!(await erasedUser(ctx, userId))) throw new Error("Begin auth erasure first.");
+    const session = await ctx.db.query("sessions").withIndex("by_user", q => q.eq("userId", userId)).first();
+    if (session) {
+      const tokens = await ctx.db.query("refreshTokens").withIndex("by_session_state", q => q.eq("sessionId", session._id)).take(101);
+      for (const token of tokens.slice(0, 100)) await ctx.db.delete("refreshTokens", token._id);
+      const deletedSessions = tokens.length <= 100 ? 1 : 0;
+      if (deletedSessions) await ctx.db.delete("sessions", session._id);
+      return { linkedRowsCleared: false, deletedAccounts: 0, deletedSessions, deletedRefreshTokens: Math.min(tokens.length,100), legacyOrphansUnverified: true as const };
+    }
+    const accounts = await ctx.db.query("accounts").withIndex("by_user", q => q.eq("userId", userId)).take(101);
+    for (const account of accounts.slice(0, 100)) await ctx.db.delete("accounts", account._id);
+    return { linkedRowsCleared: accounts.length <= 100, deletedAccounts: Math.min(accounts.length,100), deletedSessions: 0, deletedRefreshTokens: 0, legacyOrphansUnverified: true as const };
+  },
+});
