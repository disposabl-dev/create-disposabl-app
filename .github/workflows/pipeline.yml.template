name: CI and deploy

on:
  pull_request:
    branches: [main]
    types: [opened, synchronize, reopened]
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      runner:
        description: Machine to compare
        type: choice
        options: [ubuntu-latest, boat-small, boat]
        default: boat
      preview:
        description: Deploy an isolated Convex preview, including the web build
        type: boolean
        default: false
      cache_scope:
        description: Use a new value for a cold run; reuse it for warm runs
        type: string
        default: benchmark-v1

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.event_name == 'workflow_dispatch' && 'manual' || github.head_ref || github.ref_name }}-${{ inputs.runner || 'default' }}
  cancel-in-progress: false

jobs:
  pipeline:
    if: github.event.deleted != true
    # Install the Boat CI GitHub App first. Fork PRs use GitHub-hosted runners.
    # DISPOSABL_CI_RUNNER can select boat-small or ubuntu-latest for normal runs.
    runs-on: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-latest' || inputs.runner || vars.DISPOSABL_CI_RUNNER || 'boat' }}
    env:
      CI_RUNNER: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-latest' || inputs.runner || vars.DISPOSABL_CI_RUNNER || 'boat' }}
    timeout-minutes: 30
    steps:
      - name: Check out repository
        uses: actions/checkout@v6
        with:
          persist-credentials: false

      - name: Record machine
        run: |
          printf 'CPUs: %s\n' "$(nproc)"
          lscpu
          free -h
          cat /etc/os-release

      - name: Install Node.js
        uses: actions/setup-node@v6
        with:
          node-version: "24"
          package-manager-cache: false

      - name: Install Bun
        uses: oven-sh/setup-bun@v2
        with:
          bun-version: "1.4.4"

      - name: Cache Turbo tasks
        uses: actions/cache@v4
        with:
          path: .turbo/cache
          key: turbo-${{ inputs.cache_scope || 'ci' }}-${{ env.CI_RUNNER }}-${{ runner.os }}-${{ runner.arch }}-node24-bun1.4.4-${{ github.sha }}
          restore-keys: |
            turbo-${{ inputs.cache_scope || 'ci' }}-${{ env.CI_RUNNER }}-${{ runner.os }}-${{ runner.arch }}-node24-bun1.4.4-

      - name: Install dependencies
        run: bun install --frozen-lockfile

      - name: Typecheck
        run: bun run typecheck

      - name: Lint
        run: bun run lint

      - name: Check formatting
        run: bun fmt --check

      - name: Test
        # The starter currently has no tests. Run any tests added later.
        run: bun test --pass-with-no-tests

      - name: Build
        # Trusted branches build once below, with their actual deployment URLs.
        if: (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository) || (github.event_name == 'workflow_dispatch' && !inputs.preview)
        env:
          VITE_CONVEX_URL: https://ci.invalid
          VITE_CONVEX_SITE_URL: https://ci.invalid
        run: bun run build

      - name: Deploy production
        id: production
        if: github.event_name == 'push'
        working-directory: packages/backend
        env:
          CONVEX_DEPLOY_KEY: ${{ secrets.CONVEX_DEPLOY_KEY }}
        run: |
          bun x --no-install convex deploy --yes \
            --cmd-url-env-var-name VITE_CONVEX_URL \
            --cmd '
              bun x --no-install --package @convex-dev/auth auth --keys-only --prod &&
              build_started=$(date +%s) &&
              VITE_CONVEX_SITE_URL="$CONVEX_SITE_URL" bun run --cwd ../.. build &&
              echo "Web build seconds: $(($(date +%s) - build_started))" &&
              echo "url=$CONVEX_SITE_URL" >> "$GITHUB_OUTPUT"
            '
          bun x --no-install static-hosting upload --prod --no-spa --dist ../../apps/web/dist/client

      - name: Deploy preview
        id: preview
        if: (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository) || (github.event_name == 'workflow_dispatch' && inputs.preview)
        working-directory: packages/backend
        env:
          CONVEX_DEPLOY_KEY: ${{ secrets.CONVEX_DEPLOY_KEY_PREVIEW }}
          # Each benchmark runner gets its own preview to avoid concurrent writes.
          PREVIEW_NAME: ${{ github.head_ref || format('ci-benchmark-{0}', inputs.runner) }}
        run: |
          bun x --no-install convex deploy --yes --preview-name "$PREVIEW_NAME" \
            --cmd-url-env-var-name VITE_CONVEX_URL \
            --cmd '
              bun x --no-install --package @convex-dev/auth auth --keys-only --preview-name "$PREVIEW_NAME" &&
              build_started=$(date +%s) &&
              VITE_CONVEX_SITE_URL="$CONVEX_SITE_URL" bun run --cwd ../.. build &&
              echo "Web build seconds: $(($(date +%s) - build_started))" &&
              echo "url=$CONVEX_SITE_URL" >> "$GITHUB_OUTPUT"
            '
          bun x --no-install static-hosting upload --preview-name "$PREVIEW_NAME" --no-spa --dist ../../apps/web/dist/client

      - name: Show deployment URL
        if: steps.production.outcome == 'success' || steps.preview.outcome == 'success'
        env:
          DEPLOYMENT_URL: ${{ steps.production.outputs.url || steps.preview.outputs.url }}
        run: |
          printf 'Deployed app: %s\n' "$DEPLOYMENT_URL"
          printf '### Deployment\n\n[Open app](%s)\n' "$DEPLOYMENT_URL" >> "$GITHUB_STEP_SUMMARY"
